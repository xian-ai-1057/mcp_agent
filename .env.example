# Copy to `.env` in the repository root and fill in.
#
# Loaded by the entry points (`agent/cli.py`, `evals/run_eval.py`) — not at
# import time, so the test suite stays hermetic. An already-exported variable
# wins over this file; an exported-but-empty one does not.
# Point somewhere else with `--env-file path/to/other.env`.

# --- Gateway (OpenAI-compatible) -------------------------------------------
# Base URL WITHOUT the trailing /chat/completions.
GATEWAY_BASE_URL=https://your-gateway.example.com/v1
GATEWAY_API_KEY=replace-me
GATEWAY_MODEL=fedgpt-medium
GATEWAY_TIMEOUT=60

# --- Glossary ---------------------------------------------------------------
# CSV asset. Reloaded automatically when its mtime/size changes (no restart).
GLOSSARY_CSV=data/glossary.csv

# --- Agent loop -------------------------------------------------------------
AGENT_MAX_TURNS=6
# generic keeps the agent capability-neutral; translation adds terminology
# instructions and the bounded verification policy.
AGENT_PROFILE=generic
AGENT_MAX_RETRANSLATE=2

# --- RAG upload MCP (only used when enabled by --mcp-config) -----------------
# Point this at the existing RAG manager API. HTTP is accepted only on loopback.
RAG_UPLOAD_BASE_URL=https://your-rag-manager.example.com
# os.pathsep-separated directories the MCP server may read (":" on macOS/Linux).
RAG_UPLOAD_ALLOWED_ROOTS=/path/to/trusted/staging
# Optional comma-separated destination allowlist.
RAG_UPLOAD_ALLOWED_KB_NAMES=example_kb
RAG_UPLOAD_MAX_BYTES=26214400
RAG_UPLOAD_TIMEOUT_SECONDS=30
# Optional scoped gateway credential; never inherited unless mcp config names it.
RAG_UPLOAD_BEARER_TOKEN=
# Archives are rejected by default because ingestion expands them asynchronously.
RAG_UPLOAD_ALLOW_ARCHIVES=false

# --- get_weather ------------------------------------------------------------
# stub       : no network, deterministic canned reading (default)
# open-meteo : live call to https://api.open-meteo.com (no API key required)
WEATHER_PROVIDER=stub
