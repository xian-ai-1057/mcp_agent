# --- Gateway (OpenAI-compatible) -------------------------------------------
# Base URL WITHOUT the trailing /chat/completions.
GATEWAY_BASE_URL=https://your-gateway.example.com/v1
GATEWAY_API_KEY=replace-me
GATEWAY_MODEL=fedgpt-medium
GATEWAY_TIMEOUT=60

# --- Glossary ---------------------------------------------------------------
# CSV asset. Reloaded automatically when its mtime/size changes (no restart).
GLOSSARY_CSV=data/glossary.csv

# --- Agent loop -------------------------------------------------------------
AGENT_MAX_TURNS=6
AGENT_MAX_RETRANSLATE=2

# --- get_weather ------------------------------------------------------------
# stub       : no network, deterministic canned reading (default)
# open-meteo : live call to https://api.open-meteo.com (no API key required)
WEATHER_PROVIDER=stub
